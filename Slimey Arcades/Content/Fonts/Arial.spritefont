<?xml version="1.0" encoding="utf-8"?>

<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
	<Asset Type="Graphics:FontDescription">

		<FontName>Meiryo</FontName>

		<Size>100</Size>

		<Spacing>0</Spacing>

		<UseKerning>true</UseKerning>

		<Style>Regular</Style>

		<!-- 登録されていない文字は ? に置き換える -->
		<DefaultCharacter>?</DefaultCharacter>

		<CharacterRegions>

			<!-- 半角英数字・記号 -->
			<CharacterRegion>
				<Start>&#32;</Start>
				<End>&#126;</End>
			</CharacterRegion>

			<!-- 丸数字 ①～⑩ -->
			<CharacterRegion>
				<Start>&#x2460;</Start>
				<End>&#x2469;</End>
			</CharacterRegion>

			<!-- 全角記号 -->
			<CharacterRegion>
				<Start>&#x3000;</Start>
				<End>&#x303F;</End>
			</CharacterRegion>

			<!-- ひらがな -->
			<CharacterRegion>
				<Start>&#x3040;</Start>
				<End>&#x309F;</End>
			</CharacterRegion>

			<!-- カタカナ -->
			<CharacterRegion>
				<Start>&#x30A0;</Start>
				<End>&#x30FF;</End>
			</CharacterRegion>

			<!-- 以下、設定画面で使用する漢字だけ登録 -->

			<!-- 初 -->
			<CharacterRegion>
				<Start>&#x521D;</Start>
				<End>&#x521D;</End>
			</CharacterRegion>

			<!-- 値 -->
			<CharacterRegion>
				<Start>&#x5024;</Start>
				<End>&#x5024;</End>
			</CharacterRegion>

			<!-- 変 -->
			<CharacterRegion>
				<Start>&#x5909;</Start>
				<End>&#x5909;</End>
			</CharacterRegion>

			<!-- 定 -->
			<CharacterRegion>
				<Start>&#x5B9A;</Start>
				<End>&#x5B9A;</End>
			</CharacterRegion>

			<!-- 戻 -->
			<CharacterRegion>
				<Start>&#x623B;</Start>
				<End>&#x623B;</End>
			</CharacterRegion>

			<!-- 更 -->
			<CharacterRegion>
				<Start>&#x66F4;</Start>
				<End>&#x66F4;</End>
			</CharacterRegion>

			<!-- 期 -->
			<CharacterRegion>
				<Start>&#x671F;</Start>
				<End>&#x671F;</End>
			</CharacterRegion>

			<!-- 決 -->
			<CharacterRegion>
				<Start>&#x6C7A;</Start>
				<End>&#x6C7A;</End>
			</CharacterRegion>

			<!-- 画 -->
			<CharacterRegion>
				<Start>&#x753B;</Start>
				<End>&#x753B;</End>
			</CharacterRegion>

			<!-- 示 -->
			<CharacterRegion>
				<Start>&#x793A;</Start>
				<End>&#x793A;</End>
			</CharacterRegion>

			<!-- 色 -->
			<CharacterRegion>
				<Start>&#x8272;</Start>
				<End>&#x8272;</End>
			</CharacterRegion>

			<!-- 表 -->
			<CharacterRegion>
				<Start>&#x8868;</Start>
				<End>&#x8868;</End>
			</CharacterRegion>

			<!-- 設 -->
			<CharacterRegion>
				<Start>&#x8A2D;</Start>
				<End>&#x8A2D;</End>
			</CharacterRegion>

			<!-- 量 -->
			<CharacterRegion>
				<Start>&#x91CF;</Start>
				<End>&#x91CF;</End>
			</CharacterRegion>

			<!-- 面 -->
			<CharacterRegion>
				<Start>&#x9762;</Start>
				<End>&#x9762;</End>
			</CharacterRegion>

			<!-- 音 -->
			<CharacterRegion>
				<Start>&#x97F3;</Start>
				<End>&#x97F3;</End>
			</CharacterRegion>

		</CharacterRegions>

	</Asset>
</XnaContent>